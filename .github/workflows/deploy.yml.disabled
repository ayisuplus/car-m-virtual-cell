# ============================================================
# CAR-M Virtual Cell Simulator — 部署工作流
# 触发条件：push 到 main / 手动触发
# 部署目标：阿里云 ECS + Nginx
# ============================================================

name: Deploy

on:
  push:
    branches: [main]
  workflow_dispatch:      # 允许手动触发

concurrency:
  group: deploy
  cancel-in-progress: false   # 部署不允许被取消

jobs:
  # ==========================================================
  # Job 1: 构建
  # ==========================================================
  build:
    name: Build
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: app

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22.x
          cache: npm
          cache-dependency-path: app/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Type check
        run: npx tsc -b --noEmit 2>&1 || npx tsc --noEmit 2>&1

      - name: Build
        run: npm run build

      # ---- 压缩 3D 模型 (.glb → .glb.gz) ----
      - name: Gzip 3D models
        run: |
          if ls public/models/*.glb 1> /dev/null 2>&1; then
            echo "压缩 3D 模型文件..."
            for f in public/models/*.glb; do
              gzip -k -9 "$f"
              echo "  $(basename $f) → $(basename $f).gz"
            done
            # 复制压缩后的模型到 dist
            mkdir -p dist/models
            cp public/models/*.glb.gz dist/models/
          fi

      # ---- 创建部署包 ----
      - name: Create deploy package
        run: |
          tar -czf deploy-package.tar.gz \
            --exclude='*.map' \
            -C dist .
          echo "部署包大小: $(du -h deploy-package.tar.gz | cut -f1)"

      - name: Upload deploy package
        uses: actions/upload-artifact@v4
        with:
          name: deploy-package
          path: app/deploy-package.tar.gz
          retention-days: 1

  # ==========================================================
  # Job 2: 部署到阿里云 ECS
  # ==========================================================
  deploy:
    name: Deploy to Aliyun ECS
    runs-on: ubuntu-latest
    needs: build
    environment:
      name: production
      url: https://${{ vars.DOMAIN || secrets.SSH_HOST }}

    steps:
      - name: Download deploy package
        uses: actions/download-artifact@v4
        with:
          name: deploy-package

      # ---- 上传部署包到服务器 ----
      - name: Upload to server
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.SSH_HOST }}
          port: ${{ secrets.SSH_PORT || 22 }}
          username: ${{ secrets.SSH_USERNAME }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          source: deploy-package.tar.gz
          target: /tmp/

      # ---- 远程部署步骤 ----
      - name: Execute remote deploy script
        uses: appleboy/ssh-action@v1.2.2
        with:
          host: ${{ secrets.SSH_HOST }}
          port: ${{ secrets.SSH_PORT || 22 }}
          username: ${{ secrets.SSH_USERNAME }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          script: |
            set -e
            DEPLOY_DIR="${{ vars.DEPLOY_DIR || '/var/www/car-m-virtual-cell' }}"

            echo "=========================================="
            echo "  CAR-M Simulator — 远程部署"
            echo "  目标目录: ${DEPLOY_DIR}"
            echo "=========================================="

            # 1. 确保目录结构存在
            sudo mkdir -p ${DEPLOY_DIR}/dist ${DEPLOY_DIR}/backup

            # 2. 备份当前版本
            echo "[1/5] 备份当前版本..."
            if [ -f ${DEPLOY_DIR}/dist/index.html ]; then
              BACKUP_FILE="${DEPLOY_DIR}/backup/backup-$(date +%Y%m%d-%H%M%S).tar.gz"
              sudo tar -czf "${BACKUP_FILE}" -C ${DEPLOY_DIR}/dist . 2>/dev/null || true
              echo "  备份已保存: ${BACKUP_FILE}"
            else
              echo "  首次部署，跳过备份"
            fi

            # 3. 清空并解压新版本
            echo "[2/5] 部署新版本..."
            sudo rm -rf ${DEPLOY_DIR}/dist/*
            sudo tar -xzf /tmp/deploy-package.tar.gz -C ${DEPLOY_DIR}/dist
            sudo rm -f /tmp/deploy-package.tar.gz

            # 4. 设置权限
            echo "[3/5] 设置文件权限..."
            sudo chmod -R 755 ${DEPLOY_DIR}/dist/
            if id nginx &>/dev/null; then
              sudo chown -R nginx:nginx ${DEPLOY_DIR}/dist/
            elif id www-data &>/dev/null; then
              sudo chown -R www-data:www-data ${DEPLOY_DIR}/dist/
            fi

            # 5. 验证部署
            echo "[4/5] 验证部署..."
            if [ -f ${DEPLOY_DIR}/dist/index.html ]; then
              echo "  ✅ index.html 存在"
            else
              echo "  ❌ index.html 缺失！"
              exit 1
            fi
            echo "  文件数量: $(find ${DEPLOY_DIR}/dist -type f | wc -l)"

            # 6. 重载 Nginx
            echo "[5/5] 重载 Nginx..."
            sudo nginx -t && sudo systemctl reload nginx
            echo "  ✅ Nginx 重载成功"

            echo ""
            echo "=========================================="
            echo "  ✅ 部署完成！"
            echo "=========================================="

  # ==========================================================
  # Job 3: 部署后验证（可选，手动触发时跳过）
  # ==========================================================
  verify:
    name: Verify Deployment
    runs-on: ubuntu-latest
    needs: deploy
    if: github.event_name == 'push'   # 仅在 push 时自动验证

    steps:
      - name: Health check
        run: |
          HOST="${{ secrets.SSH_HOST }}"
          echo "验证部署: http://${HOST}"
          HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 "http://${HOST}/" || echo "000")

          if [ "$HTTP_CODE" = "200" ]; then
            echo "✅ HTTP ${HTTP_CODE} — 站点正常"
          else
            echo "⚠️  HTTP ${HTTP_CODE} — 请手动检查"
            # 不阻塞 pipeline，可能是防火墙/安全组限制
          fi
